# Copy the real values into .env.local (never committed). This file is safe to commit.

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) API key from Settings -> API
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fallback passphrase (if used)
PASSPHRASE=

# Security questions JSON for the gate. Real questions and correct answers live ONLY in this env var!
# Multiple acceptable answers can be specified per question.
# Example:
# SECURITY_QUESTIONS='[{"id":1,"question":"Where was our very first date?","answers":["The Garden","Olive Garden"]},{"id":2,"question":"What is our pet name?","answers":["Biscuit"]},{"id":3,"question":"What song did we dance to at the wedding?","answers":["Perfect","Ed Sheeran"]}]'
SECURITY_QUESTIONS=